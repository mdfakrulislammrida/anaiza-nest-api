APP_NAME="Anaiza Nest API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# A new log file each day; files older than LOG_DAILY_DAYS (default 14) are removed.
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---
# Quick local start: leave as sqlite and run `touch database/database.sqlite`.
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite
# SQLite behaviour under several buyers at once (these are the defaults; change only for a reason):
# DB_BUSY_TIMEOUT=10000
# DB_JOURNAL_MODE=WAL
# DB_SYNCHRONOUS=NORMAL
# DB_TRANSACTION_MODE=IMMEDIATE

# For production (e.g. MySQL on shared hosting or a VPS), comment out the
# sqlite line above and use:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=anaiza_nest
# DB_USERNAME=anaiza_nest_user
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@anaizanest.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Filesystem (product image uploads, if switching off external URLs) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- CORS / SPA frontend (set this to your storefront's domain(s) in production) ---
# SANCTUM_STATEFUL_DOMAINS=anaizanest.com
FRONTEND_URL=https://anaizanest.com
# Which websites may call the API from a browser (comma separated full origins). Empty = FRONTEND_URL plus the shop's own
# addresses listed in config/cors.php.
# CORS_ALLOWED_ORIGINS=https://anaizanest.com,https://www.anaizanest.com

# --- Security and abuse protection (see config/abuse.php and config/trustedproxy.php) ---
# Customer sign-ins last this many minutes (default 43200 = 30 days).
# SANCTUM_EXPIRATION=43200
# The session cookie only over HTTPS. Turn on in production.
# SESSION_SECURE_COOKIE=true
# Which address the shop counts a visitor as. Leave empty until Admin > Network check says what to set.
# TRUSTED_PROXIES=
# CLIENT_IP_HEADER=
# Count limits per visitor address. Turn off ONLY if Network check shows every visitor as one address.
# THROTTLE_BY_IP=true
# Tell browsers to use HTTPS only. Turn on once the site has run on HTTPS only for a while: it cannot be taken back quickly.
# HSTS_ENABLED=false
# Refuse public forms that carry no bot-trap fields. Turn on once the storefront that sends them is live.
# ABUSE_REQUIRE_FORM_PROOF=false

# --- Social login (Google + Facebook) ---
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"
# Facebook: https://developers.facebook.com/apps
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/api/auth/facebook/callback"

# --- Backups (see config/backup.php) ---
# A nightly backup of the database and uploaded pictures is kept in storage/app/backups.
# BACKUP_ENABLED=true
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_INCLUDE_FILES=true
# Optional copy to another server over SFTP. Off by default; needs: composer require league/flysystem-sftp-v3
# BACKUP_SFTP_ENABLED=false
# BACKUP_SFTP_HOST=
# BACKUP_SFTP_PORT=22
# BACKUP_SFTP_USERNAME=
# BACKUP_SFTP_PASSWORD=
# BACKUP_SFTP_PRIVATE_KEY=
# BACKUP_SFTP_ROOT=/anaiza-nest-backups
